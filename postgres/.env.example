# Copy this file to `.env` and adjust the values before running docker compose.
POSTGRES_USER=grist
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=gristdb

# Interface to bind on the host.
#   0.0.0.0  -> reachable from anywhere that can route to this host
#   127.0.0.1 -> localhost only (not reachable from outside)
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432
